{
  "name": "dsh-writing-assistant",
  "version": "1.3.0",
  "description": "公众号文章、公文起草与深度研究三种写法的 DSH 写作台：内置写作与信源规则，共用稿件库、分块编辑、机检与 Word 导出。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "icon": "./icon.png",
  "files": [
    "lib",
    "gallery",
    "skills",
    "cordis.patch.yml",
    "icon.png",
    "README.md",
    "CHANGELOG.md"
  ],
  "displayName": "写作助手",
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "dsh",
    "writing",
    "official-document",
    "research-writing",
    "editor",
    "ui",
    "tool"
  ],
  "author": "lilongyi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryuuichi2000/dsh-writing-assistant.git"
  },
  "homepage": "https://github.com/ryuuichi2000/dsh-writing-assistant#readme",
  "bugs": {
    "url": "https://github.com/ryuuichi2000/dsh-writing-assistant/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.4.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
